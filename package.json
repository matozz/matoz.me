    "framer-motion": "^14.14.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "next-seo": "^7.3.0",
    "next-themes": "^0.4.6",
    "notion-client": "8.0.8",
    "notion-types": "8.0.8",
    "notion-utils": "8.0.8",
